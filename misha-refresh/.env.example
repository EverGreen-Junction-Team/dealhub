# The production Postgres the PipelinePulse server uses. The misha schema
# lives in the same database — this job reads messages/opportunities and
# writes only into misha.*.
DATABASE_URL=

# Claude. One call per message (two for customer messages), so this key
# carries real spend — see MAX_MESSAGES_PER_RUN below.
#
# Use a WORKSPACE-scoped key (the PipelinePulse server uses one — copy it from
# server/.env). An organisation-level key is rejected on every call with
# "This API key is not scoped to a workspace"; if you must use one, set
# ANTHROPIC_WORKSPACE_ID below as well.
ANTHROPIC_API_KEY=

# Only for an ORGANISATION-level key. Leave blank when the key above is
# workspace-scoped — which is the simpler setup.
# ANTHROPIC_WORKSPACE_ID=

# Safety valve. One run will not process more than this many messages, no
# matter how far behind the watermark is. A backfill or a busy weekend
# otherwise turns into an unbounded API bill overnight. The next run picks
# up where this one stopped, so a cap costs time, never data.
MAX_MESSAGES_PER_RUN=500

# Locations are read from `installs` and need no configuration. Set this
# ONLY to pin the job to specific sub-accounts (comma-separated) — e.g. to
# re-run one client after a fix.
# ONLY_LOCATION_IDS=

# Print what would happen and write nothing. No Claude calls are made.
# DRY_RUN=1

# Postgres SSL is ON by default, which is what production needs. Set this to
# `disable` only for a local database that does not offer SSL.
# PGSSL=disable
