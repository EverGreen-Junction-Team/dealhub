# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Public-facing base URL (used in OAuth redirect_uri + webhook receiver URL
# you register with GHL). Locally use ngrok / cloudflared / etc. In production
# this is the Caddy-fronted https://<your-uk-host>.
PUBLIC_BASE_URL=https://your-tunnel.example.com

# --- Postgres / Supabase ---
# Self-hosted Supabase exposes a standard Postgres connection on port 5432.
# Get the credentials from your elest.io / Supabase dashboard. We use the
# `postgres` role for migrations; runtime queries set the `app.location_id`
# session variable so Row-Level Security enforces tenant isolation.
DATABASE_URL=postgres://postgres:PASSWORD@HOST:5432/postgres

# --- GHL Marketplace App ---
# Get these from the GHL Marketplace developer dashboard after creating the
# private app for the client's sub-account(s).
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Marketplace app id — needed for agency-level installs (see agencyInstall.js)
GHL_APP_ID=
GHL_REDIRECT_URI=https://your-tunnel.example.com/oauth/callback

# GHL signs webhook payloads with their RSA private key. Download the public
# key from the marketplace developer dashboard and paste it here (escape
# newlines as \n).
GHL_WEBHOOK_PUBLIC_KEY=

# --- Orphan opportunity sweep ---
# Daily cron — fires the "still pending" webhook for any opportunity that was
# created in GHL but never moved stage. Default: 03:00 server time.
ORPHAN_SWEEP_CRON=0 3 * * *

# Internal secret for admin endpoints (e.g. manual re-sweep trigger).
INTERNAL_API_KEY=

# ── Deal Hub AI (Claude) ────────────────────────────────────────────────
# Optional: without it the app boots normally and the AI routes report
# "not configured" instead of failing the whole server.
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5. Only override deliberately.
ANTHROPIC_MODEL=claude-sonnet-5

# ── Conversation Point (call recording + transcription) ──────────────────
# See src/conversationPoint/README.md. All optional; the feature degrades
# step by step rather than blocking boot.
CP_ENABLED=true
# OpenAI key for transcription (whisper-1). Without it calls are stored and
# matched but the transcribe step waits.
OPENAI_API_KEY=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=en
# Where our copy of each recording lives: local (RECORDINGS_DIR) or supabase.
RECORDING_STORAGE=local
RECORDINGS_DIR=data/recordings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RECORDINGS_BUCKET=call-recordings
# Worker cadence.
CP_WORKER_INTERVAL_MS=5000
CP_WORKER_BATCH=3
CP_DEFAULT_COUNTRY=GB
# GHL conversation provider (type Call) for mirroring calls into GHL.
# Empty = ghl_sync step is skipped.
GHL_CALL_PROVIDER_ID=
# Allo — single-tenant fallback. Per-location values set via
# PUT /api/calls/providers/allo win over these.
ALLO_API_KEY=
ALLO_WEBHOOK_SECRET=
ALLO_API_BASE_URL=https://api.withallo.com
